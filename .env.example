# Application Settings
PROJECT_NAME="WhistleDrop"
ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated origins or JSON array)
# In development, standard localhost origins are used by default if omitted.
# In production, explicitly specify exact client origins (e.g. https://whistledrop.example.com).
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Cryptographic Secrets (Distinct secrets for separate cryptographic domains)
# Generate random 256-bit keys (e.g. `openssl rand -hex 32`):
# NEVER reuse the same secret for both JWT authentication and case-code derivation.
JWT_SECRET="replace-with-a-secure-random-secret-for-jwt-tokens-minimum-32-chars"
CASE_CODE_SECRET="replace-with-a-secure-random-secret-for-case-codes-minimum-32-chars"
JWT_ALGORITHM="HS256"
JWT_ISSUER="whistledrop-api"
JWT_AUDIENCE="whistledrop-moderators"
ACCESS_TOKEN_EXPIRE_MINUTES=30



# Database Configuration (Development PostgreSQL with Async SQLAlchemy / asyncpg)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="whistledrop"
POSTGRES_PASSWORD="whistledrop_dev_password"
POSTGRES_DB="whistledrop_db"
DATABASE_URL="postgresql+asyncpg://whistledrop:whistledrop_dev_password@localhost:5432/whistledrop_db"

# Redis Configuration (Ephemeral Rate Limiting & Abuse Resistance)
REDIS_URL="redis://localhost:6379/0"

# Dedicated Rate Limiting Key Secret (HMAC-SHA256 client bucket derivation)
# NEVER reuse JWT_SECRET or CASE_CODE_SECRET for rate-limit buckets.
RATE_LIMIT_KEY_SECRET="replace-with-a-secure-random-secret-for-rate-limit-keys-min-32"

# Trusted Proxy Configuration
# TRUSTED_PROXY_CIDRS: comma-separated CIDR networks whose socket peers may supply X-Forwarded-For (e.g. "127.0.0.1/32,10.0.0.0/8")
# TRUSTED_PROXY_COUNT: number of trusted proxy hops to skip from right-to-left in X-Forwarded-For
TRUSTED_PROXY_CIDRS=""
TRUSTED_PROXY_COUNT=0

# Rate Limiting Policies (Configurable thresholds and sliding window sizes in seconds)
SUBMISSION_RATE_LIMIT=5
SUBMISSION_RATE_WINDOW_SECONDS=300

LOOKUP_RATE_LIMIT=10
LOOKUP_RATE_WINDOW_SECONDS=60

LOOKUP_GLOBAL_RATE_LIMIT=100
LOOKUP_GLOBAL_RATE_WINDOW_SECONDS=60

LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

# Evidence Attachment Upload Rate Limiting (Dedicated policy for evidence uploads)
ATTACHMENT_UPLOAD_RATE_LIMIT=10
ATTACHMENT_UPLOAD_RATE_WINDOW_SECONDS=300

# Evidence Attachment Storage & Resource Bounds (Phase 8)
MAX_ATTACHMENT_SIZE_MB=10
MAX_ATTACHMENTS_PER_REPORT=5
MAX_TOTAL_ATTACHMENT_BYTES=26214400
MIN_FREE_STORAGE_MB=1024
EVIDENCE_STORAGE_PATH="./evidence_storage"
PENDING_SCAN_MAX_AGE_HOURS=24
QUARANTINE_RETENTION_HOURS=72
RECONCILIATION_INTERVAL_MINUTES=60

# ClamAV Antivirus Scanner (INSTREAM Protocol)
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT=30

