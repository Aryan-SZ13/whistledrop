# Application Settings
PROJECT_NAME="WhistleDrop"
ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated origins or JSON array)
# In development, standard localhost origins are used by default if omitted.
# In production, explicitly specify exact client origins (e.g. https://whistledrop.example.com).
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000"

# Cryptographic Secrets (Distinct secrets for separate cryptographic domains)
# Generate random 256-bit keys (e.g. `openssl rand -hex 32`):
# NEVER reuse the same secret for both JWT authentication and case-code derivation.
JWT_SECRET="replace-with-a-secure-random-secret-for-jwt-tokens-minimum-32-chars"
CASE_CODE_SECRET="replace-with-a-secure-random-secret-for-case-codes-minimum-32-chars"
JWT_ALGORITHM="HS256"
JWT_ISSUER="whistledrop-api"
JWT_AUDIENCE="whistledrop-moderators"
ACCESS_TOKEN_EXPIRE_MINUTES=30



# Database Configuration (Development PostgreSQL with Async SQLAlchemy / asyncpg)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="whistledrop"
POSTGRES_PASSWORD="whistledrop_dev_password"
POSTGRES_DB="whistledrop_db"
DATABASE_URL="postgresql+asyncpg://whistledrop:whistledrop_dev_password@localhost:5432/whistledrop_db"
